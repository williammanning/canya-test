# LaunchDarkly SDK Key (server-side)
LAUNCHDARKLY_SDK_KEY=your_launchdarkly_sdk_key_here

# Optional: LaunchDarkly AI Config key for chatbot (for example: canya-chatbot-assistant)
LAUNCHDARKLY_CHATBOT_AI_CONFIG_KEY=

# Gemini AI API Key (for chatbot feature)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port
PORT=3000
